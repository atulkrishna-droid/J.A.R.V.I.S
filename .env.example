# J.A.R.V.I.S. configuration examples. This file contains no credentials.
# Copy only the values you need; keep .env.local and any real secrets untracked.
#
# Vite loads VITE_* values from .env.local. The Node bridges read their own
# settings from the process environment and do not load .env.local automatically.

# ------------------------------ Frontend (Vite) ----------------------------
# ollama (default): local Ollama bridge; bridge: optional Claude Agent SDK;
# direct: legacy browser-to-Anthropic mode (exposes its key to client code).
VITE_BACKEND=ollama
VITE_BRIDGE_URL=ws://localhost:8787
# Set false to select the original browser/Three.js interface instead.
VITE_DESKTOP_SHELL=true
VITE_TTS_ENGINE=system
VITE_KOKORO_VOICE=bm_george
VITE_USE_ELEVENLABS=false

# Optional browser-facing credentials. Keep blank unless using the legacy
# browser provider, and never put real values in a committed example file.
VITE_ANTHROPIC_API_KEY=
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=
VITE_PICOVOICE_ACCESS_KEY=

# ------------------------------ Ollama bridge ------------------------------
# Export these in the environment that launches `npm run bridge:ollama` or
# `npm start`; they are not read from .env.local by the Node bridge.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
JARVIS_BRIDGE_PORT=8787

# Optional local voice tools and model files.
WHISPER_MODEL=
PIPER_MODEL=

# ------------------------------ Legacy bridge ------------------------------
# These apply only to bridge/server.mjs and its optional MCP integrations.
JARVIS_MODEL=
JARVIS_EFFORT=medium
JARVIS_ALLOW_WRITES=0
JARVIS_ALLOWED_ORIGINS=
JARVIS_ALLOW_NO_ORIGIN=0
JARVIS_FILE_ROOTS=
JARVIS_VOICE_ID=
JARVIS_DEBUG=0
ELEVENLABS_API_KEY=

# Vite development server port, when a non-default port is needed.
PORT=5173
