{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J.A.R.V.I.S.",
  "version": "0.1.0",
  "identifier": "com.adreesumer.jarvis",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "J.A.R.V.I.S. — Local AI Assistant",
      "width": 1580,
      "height": 980,
      "minWidth": 1160,
      "minHeight": 720,
      "resizable": true,
      "fullscreen": false,
      "decorations": false,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Local AI desktop assistant",
    "longDescription": "J.A.R.V.I.S. desktop assistant powered by locally installed Ollama models.",
    "resources": {
      "../bridge/ollama.mjs": "bridge/ollama.mjs",
      "../node_modules/ws": "node_modules/ws"
    },
    "linux": { "deb": { "depends": ["nodejs", "libwebkit2gtk-4.1-0"] } }
  }
}
